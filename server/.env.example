PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dineflow
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# auto: Razorpay when keys are set, else the built-in test gateway (never in production). Also: razorpay | mock | none
PAYMENT_GATEWAY=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret of the webhook pointing at /api/v1/payments/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid online checkout stays open before it is cancelled and the cart restored
PAYMENT_WINDOW_MINUTES=15
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CHATBOT_PROVIDER=openai-compatible
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_API_KEY=
CHATBOT_MODEL=gpt-4o-mini
