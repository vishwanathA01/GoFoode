# Leave empty to use the built-in /api proxy. Set only if the API is on another host, e.g. https://api.example.com/api/v1
VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=
# Map tiles for live tracking and the location pin. Leave empty to use OpenStreetMap's tiles (fair use only).
# For production traffic use a hosted tile service, e.g. https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
# Show the rider's "Demo ride" button in production builds too (it is always on in development).
VITE_DEMO_TOOLS=
