{
  "name": "GoFoode: Food, delivered better",
  "short_name": "GoFoode",
  "description": "Order from local kitchens, track your rider live, and win daily rewards.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fffdfb",
  "theme_color": "#ff6b35",
  "orientation": "portrait-primary",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Order food", "url": "/food", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Spin today's wheel", "url": "/rewards", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Track my order", "url": "/customer/orders", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
